<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#040303"
    android:padding="16dp">

    <!--หน้าจอแสดงผล-->
    <TextView
        android:id="@+id/txedisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textStyle="bold"
        android:padding="16dp"
        android:textColor="#00FF4D"
        android:gravity="end"
        android:background="#2A2727"
        android:layout_marginBottom="12dp"
        android:textSize="36sp" />


<!-- โซนปุ่ม-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <!--แถวที่ 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">


            <!-- แต่ละปุ่ม-->
            <Button
                android:id="@+id/btnAC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="AC"
                android:textStyle="bold"
                android:textColor="#FF0000"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEL"
                android:textColor="#0037FF"
                android:textStyle="bold"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnMod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="%"
                android:textColor="#C500FF"
                android:textStyle="bold"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="/"
                android:textStyle="bold"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>



        </LinearLayout>

        <!-- แถวที่ 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">


        <!-- แต่ละปุ่ม-->

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="7"
                android:backgroundTint="#313131"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8"
            android:textStyle="bold"
                android:textColor="#FFFFFF"
            android:layout_margin="4dp"
            android:backgroundTint="#313131"/>

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#313131"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnMulj"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:backgroundTint="#313131"
            android:text="*"

            android:layout_margin="4dp"/>



    </LinearLayout>
<!-- แถวที่ 3-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">


            <!-- แต่ละปุ่ม-->
            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="5"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnDele"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="-"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>



        </LinearLayout>
<!--แถวที่4-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">


            <!-- แต่ละปุ่ม-->
            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:backgroundTint="#313131"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnplus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>



        </LinearLayout>
<!--แถวที่ 5-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">


            <!-- แต่ละปุ่ม-->
            <Button
                android:id="@+id/btnAA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="AC"
                android:backgroundTint="#313131"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnEqual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textColor="#FFFFFF"
                android:backgroundTint="#313131"
                android:layout_margin="4dp"/>



        </LinearLayout>






    </LinearLayout>





</LinearLayout>